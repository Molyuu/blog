---
// Pass extra lines (e.g. previous/next links) as children; without children the
// footer opens with just the email address.
// `showUpdated={false}` hides the「最后修改」line (the home page does this).
import { SITE_EMAIL } from '../consts';
import { isoDate } from '../utils/date';

interface Props {
	showUpdated?: boolean;
}

const { showUpdated = true } = Astro.props;
const built = isoDate(new Date());
---

<footer>
	<slot>
		<p><a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a></p>
	</slot>
	<p>
		&copy; {built.slice(0, 4)} Molyuu ·{' '}
		<a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank">CC BY-NC-SA 4.0</a>
		{' '}· <a href="https://github.com/Molyuu" target="_blank">GitHub</a>
	</p>
	{showUpdated && <p class="mono updated">最后修改 {built}</p>}
</footer>

<style>
	footer {
		display: flex;
		flex-direction: column;
		gap: 4px;
		font-size: 14px;
		color: var(--muted);
		line-height: 1.7;
		text-align: center;
	}
	.updated {
		font-size: 13px;
	}
</style>
