---
// Home page header: shell prompt, site name, one-line intro and text navigation.
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const links = [
	{ href: '/blog/', label: '文章' },
	{ href: '/about/', label: '关于' },
	{ href: '/rss.xml', label: 'RSS' },
];
---

<header>
	<p class="prompt mono muted">~/molyuu $ cat index.txt</p>
	<h1>{SITE_TITLE}</h1>
	<p>{SITE_DESCRIPTION}</p>
	<nav aria-label="主导航">
		{
			links.map(({ href, label }, i) => (
				<>
					{i > 0 && <span aria-hidden="true">/</span>}
					<a href={href}>{label}</a>
				</>
			))
		}
	</nav>
</header>

<style>
	header {
		display: flex;
		flex-direction: column;
		gap: 12px;
		text-align: center;
	}
	.prompt {
		font-size: 13px;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6px 10px;
		font-size: 16px;
	}
	nav span {
		color: var(--faint);
	}
</style>
