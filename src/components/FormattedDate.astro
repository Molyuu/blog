---
import { isoDate } from '../utils/date';

interface Props {
	date: Date;
	/** `full` → YYYY-MM-DD, `short` → MM-DD */
	format?: 'full' | 'short';
}

const { date, format = 'full' } = Astro.props;
const text = isoDate(date);
---

<time datetime={date.toISOString()}>{format === 'short' ? text.slice(5) : text}</time>
