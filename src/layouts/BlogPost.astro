---
import type { CollectionEntry } from 'astro:content';
import BackLink from '../components/BackLink.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { Neighbor } from '../utils/posts';
import { roundWords } from '../utils/posts';
import Base from './Base.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	words: number;
	newer?: Neighbor;
	older?: Neighbor;
};

const { title, pubDate, updatedDate, heroImage, words, newer, older } = Astro.props;
---

<Base title={title} image={heroImage}>
	<BackLink />
	<main>
		<article class="stack">
			<header class="page-header">
				<h1>{title}</h1>
				<p class="meta">
					<FormattedDate date={pubDate} /> · 约 {roundWords(words)} 字
					{updatedDate && <> · 更新于 <FormattedDate date={updatedDate} /></>}
				</p>
			</header>
			<hr />
			<div class="prose">
				<slot />
			</div>
		</article>
	</main>
	<hr />
	<Footer>
		<nav class="post-nav" aria-label="上一篇和下一篇">
			{older ? <a href={`/blog/${older.id}/`}>← {older.title}</a> : <span>（这是第一篇）</span>}
			{newer ? <a href={`/blog/${newer.id}/`}>{newer.title} →</a> : <span>（这是最新一篇）</span>}
		</nav>
	</Footer>
</Base>

<style>
	.post-nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px 24px;
		margin-bottom: 6px;
		font-size: 15px;
	}
</style>
